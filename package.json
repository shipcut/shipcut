{
  "name": "shipcut",
  "version": "0.1.0",
  "description": "Record screenshots and short videos of a web app's flows and publish them to Cloudflare R2.",
  "homepage": "https://shipcut.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shipcut/shipcut.git"
  },
  "bin": {
    "shipcut": "dist/cli.js"
  },
  "files": [
    "dist",
    "fonts",
    "skills"
  ],
  "type": "module",
  "exports": "./dist/run.js",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && pnpm -F @shipcut/web check-types && oxlint && oxfmt --check && node --test",
    "fix": "oxlint --fix && oxfmt",
    "test": "node --test",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "playwright": "~1.63.0"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.0",
    "@types/node": "^24.19.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "ultracite": "7.12.4"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0"
}
